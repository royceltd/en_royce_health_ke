# One hospital server's settings. Copy to /opt/royceerp/hospital.env on the server
# (mode 600, owner root) and fill in. Never commit a filled-in copy.
# Read by setup-server.sh, start-stack.sh and setup-backups.sh.

# --- The hospital ---------------------------------------------------------------
HOSPITAL=bethesda
# The ERPNext site. It keeps its name when it moves between servers (move-site.sh);
# only the DNS record changes.
SITE=bethesda.royceltd.com

# --- Server --------------------------------------------------------------------------
# The admin login (sudo, docker). Royce logs in as this user; root keeps key-only SSH.
ADMIN_USER=frappe
# Public key(s) allowed to log in as ADMIN_USER (one per line inside the quotes).
ADMIN_SSH_PUBKEYS="ssh-ed25519 AAAA...replace... royce"
TZ=Africa/Nairobi
# Swap file size made when the server has none (GB). 0 = don't make one.
SWAP_GB=4

# --- TLS (Cloudflare Origin CA) ---------------------------------------------------
# Copy the certificate and key to the server first (scp), then run setup-server.sh.
# The *.royceltd.com origin certificate (expires 2041) serves any server for a
# royceltd.com site. A hospital's own domain needs its own certificate.
ORIGIN_CERT=/root/origin.pem
ORIGIN_KEY=/root/origin.key
# 1 = ports 80/443 accept only Cloudflare's addresses (the DNS record is proxied,
#     orange cloud). 0 = open to everyone (DNS straight to the server).
CLOUDFLARE_ONLY=1

# --- The ERPNext stack ------------------------------------------------------------
# The image tag the stack runs (royceerp:<IMAGE_TAG>). It must already be on the
# server: ship-image.sh copies it from the pilot server, or build-image.sh builds it.
IMAGE_TAG=16-hke0.29.0
# frappe_docker commit whose compose files and image recipe we use (same as the pilot).
FRAPPE_DOCKER_COMMIT=46c7ced81efbd4a119e14b81bf78e3b77cad3309
# Frappe version the image is built on (build-image.sh only).
FRAPPE_BRANCH=v16.52.0
# Web workers: (2 x vCPU) + 1 is a good start; 5 on 4 vCPU / 8 GB.
GUNICORN_WORKERS=5
GUNICORN_THREADS=4

# --- Backups (setup-backups.sh) ----------------------------------------------------
# rclone remote the backups go to. r2-crypt:crypt = encrypted on this server before
# upload (setup-backups.sh creates it). The bucket must be this hospital's own.
RCLONE_REMOTE=r2-crypt:crypt
R2_BUCKET=royce-hospital-bethesda
# Becomes the <domain> level of the bucket paths: <tier>/<BACKUP_DOMAIN>/<site>/<time>/
BACKUP_DOMAIN=royceltd.com
# Optional: a Slack (or compatible) incoming-webhook URL. A failed backup posts there.
ALERT_WEBHOOK=
