   "fieldtype": "Link",
   "label": "Bill",
   "options": "Sales Invoice",
   "depends_on": "eval:doc.request_type!='Pay Later'",
   "mandatory_depends_on": "eval:doc.request_type!='Pay Later'",
   "description": "Discount: the visit's draft bill. Waiver: a submitted bill with a balance."
  },
  {
   "fieldname": "invoice_total",
   "fieldtype": "Currency",
   "label": "Bill Total",
